    "core-js": "^3.6.5",
    "cron": "^1.8.2",
    "mongodb": "^4.11.0",
    "mongoose": "^6.6.7",
    "nanoid": "^4.0.0",
    "plausible-tracker": "^0.3.8",
    "ramda": "^0.28.0",
