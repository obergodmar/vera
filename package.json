{
  "name": "vera-reforged",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "yarn": ">=1.22.x",
    "node": ">=16.x.x"
  },
  "scripts": {
    "dev": "concurrently -p \"[{name}]\" -n \"frontend,backend\" -c \"bgGreen.bold,bgCyan.bold\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "nx serve frontend --configuration=development",
    "dev:backend": "nx serve backend --configuration=development",
    "build:backend": "nx build backend --source-map false --configuration=production",
    "build": "concurrently -p \"[{name}]\" -n \"frontend,backend\" -c \"bgGreen.bold,bgCyan.bold\" \"npm run build:frontend\" \"npm run build:backend\"",
    "prepare": "husky install",
    "eslint:fix": "eslint --fix",
    "test:backend": "NODE_OPTIONS=\"--experimental-vm-modules\" nx test backend",
    "test:common": "nx test common",
    "deploy": "node scripts/deploy.js",
    "deploy:frontend": "node scripts/deploy.js frontend",
    "deploy:backend": "node scripts/deploy.js backend",
    "tsc": "nx run-many --target=tsc --all=true --verbose",
    "typeorm:create": "typeorm migration:create ./apps/backend/src/migrations/migration",
    "typeorm:gen": "nx run backend:typeorm-generate-migrations ./migrations/",
    "typeorm:run": "nx run backend:typeorm-run-migrations",
    "typeorm:revert": "nx run backend:typeorm-revert-migrations"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": "yarn eslint:fix"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "@nestjs/common": "10.0.5",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "10.0.5",
    "@nestjs/platform-express": "10.0.5",
    "@nestjs/serve-static": "^3.0.0",
    "@nestjs/swagger": "7.1.1",
    "@nestjs/typeorm": "^10.0.0",
    "@reduxjs/toolkit": "1.9.3",
    "@vkontakte/api-schema-typescript": "^1.5131.2",
    "@vkontakte/icons": "^2.48.1",
    "@vkontakte/superappkit": "^1.61.2",
    "@vkontakte/vk-bridge": "^2.7.2",
    "@vkontakte/vkui": "^5.6.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "classnames": "^2.3.2",
    "core-js": "^3.6.5",
    "cron": "^1.8.2",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "dotenv-cli": "^7.3.0",
    "mysql2": "^3.5.0",
    "nanoid": "^4.0.0",
    "ramda": "^0.28.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-redux": "8.0.5",
    "react-router-dom": "6.11.2",
    "react-time-picker": "^5.2.0",
    "react-transition-group": "^4.4.2",
    "redux-logger": "^3.0.6",
    "reflect-metadata": "^0.1.13",
    "regenerator-runtime": "0.13.7",
    "rxjs": "^7.0.0",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.17",
    "vk-call": "^2.2.0",
    "vk-io": "^4.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
