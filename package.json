{
  "name": "vera-reforged",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "yarn": ">=1.22.x",
    "node": ">=16.x.x"
  },
  "scripts": {
    "dev": "concurrently -p \"[{name}]\" -n \"frontend,backend\" -c \"bgGreen.bold,bgCyan.bold\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "nx serve frontend",
    "dev:backend": "nx serve backend",
    "build:frontend": "nx build frontend --source-map false",
    "build:backend": "nx build backend --source-map false",
    "build": "concurrently -p \"[{name}]\" -n \"frontend,backend\" -c \"bgGreen.bold,bgCyan.bold\" \"npm run build:frontend\" \"npm run build:backend\"",
    "prepare": "husky install",
    "eslint:fix": "eslint --fix",
    "deploy": "node scripts/deploy.js"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": "yarn eslint:fix"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
