    "@nx/jest": "16.5.0",
    "@nx/js": "16.5.0",
    "@nx/linter": "16.5.0",
    "@nx/nest": "16.5.0",
    "@nx/node": "16.5.0",
    "@nx/react": "16.5.0",
    "@nx/vite": "16.5.0",
